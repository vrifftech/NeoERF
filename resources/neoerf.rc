// Windows executable/taskbar/desktop icon and version metadata for NeoERF.
#include <winver.h>

neoerf ICON "neoerf.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Neo Tools"
            VALUE "FileDescription", "NeoERF ERF/RIM archive editor"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "NeoERF"
            VALUE "OriginalFilename", "NeoERF.exe"
            VALUE "ProductName", "NeoERF"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
